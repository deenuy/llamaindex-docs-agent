.coverage
htmlcov/

# macOS
.DS_Store

# Python packaging
build/
dist/
*.egg-info/

# PyInstaller
*.spec

# Jupyter Notebook checkpoints (optional, if any)
.ipynb_checkpoints/

# VSCode extensions settings
.vscode/

# OS generated files
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# If using Docker
docker-compose.override.yml
.env.docker

# Snapshots or temporary backups
archive/snapshots/
tmp/

# If using PyCharm
.idea/

# If using Homebrew on Mac (optional, cache dirs)
Cellar/
Caskroom/
Homebrew/

